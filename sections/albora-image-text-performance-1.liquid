{%- comment -%}
  Albora — Imagem com texto / performance 1.

  Conteúdo vindo de `product.metafields.custom.imagemcom_text_performance_1` (metaobjeto), com:
    imagem_desktop / imagem_mobile → imagem do lado esquerdo (quadrada, cantos arredondados)
    titulo                         → richtext (título em destaque)
    conteudo                       → richtext (parágrafo)

  Desktop: imagem à esquerda + texto à direita. Mobile: empilhado.
  Seções irmãs idênticas: albora-image-text-performance-1 / -2 / -3 (mudam só a chave padrão do metafield).
  Ver CLAUDE.md → "Regra de personalização de textos e botões".
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'albora-image-text-performance.css' | asset_url }}" media="all">

{%- liquid
  assign s = section.settings
  assign uid = section.id

  assign entry = product.metafields.custom.imagemcom_text_performance_1.value

  assign image_desktop = entry.imagem_desktop.value
  assign image_mobile = entry.imagem_mobile.value

  comment
    Richtext: renderiza o próprio metafield (gera o HTML), não o `.value`.
  endcomment
  assign title = entry.titulo
  assign content = entry.conteudo
  assign has_title = entry.titulo.value
  assign has_content = entry.conteudo.value
-%}

<style>
  #Albora-ImageTextPerformance-{{ uid }} {
    background-color: {{ s.background_color }};
  }
  #Albora-ImageTextPerformance-{{ uid }} .albora-itp__inner {
    max-width: {{ s.max_width }}px;
    padding: {{ s.padding_top_desktop }}px {{ s.padding_side_desktop }}px {{ s.padding_bottom_desktop }}px;
    gap: {{ s.gap_desktop }}px;
  }
  #Albora-ImageTextPerformance-{{ uid }} .albora-itp__media {
    width: {{ s.image_size_desktop }}px;
    height: {{ s.image_size_desktop }}px;
    border-radius: {{ s.image_radius }}px;
  }
  #Albora-ImageTextPerformance-{{ uid }} .albora-itp__text {
    gap: {{ s.text_gap_desktop }}px;
  }
  #Albora-ImageTextPerformance-{{ uid }} .albora-itp__title {
    font-size: {{ s.title_font_size_desktop }}px;
    font-weight: {{ s.title_font_weight }};
    line-height: {{ s.title_line_height }};
    color: {{ s.title_color }};
    text-transform: {% if s.title_uppercase %}uppercase{% else %}none{% endif %};
  }
  #Albora-ImageTextPerformance-{{ uid }} .albora-itp__content {
    font-size: {{ s.content_font_size_desktop }}px;
    font-weight: {{ s.content_font_weight }};
    line-height: {{ s.content_line_height }};
    color: {{ s.content_color }};
  }
  #Albora-ImageTextPerformance-{{ uid }} .albora-itp__content strong {
    color: {{ s.content_accent_color }};
  }

  @media screen and (max-width: 749px) {
    #Albora-ImageTextPerformance-{{ uid }} .albora-itp__inner {
      padding: {{ s.padding_top_mobile }}px {{ s.padding_side_mobile }}px {{ s.padding_bottom_mobile }}px;
      gap: {{ s.gap_mobile }}px;
    }
    #Albora-ImageTextPerformance-{{ uid }} .albora-itp__media {
      width: 100%;
      height: {{ s.image_height_mobile }}px;
    }
    #Albora-ImageTextPerformance-{{ uid }} .albora-itp__text {
      gap: {{ s.text_gap_mobile }}px;
    }
    #Albora-ImageTextPerformance-{{ uid }} .albora-itp__title {
      font-size: {{ s.title_font_size_mobile }}px;
    }
    #Albora-ImageTextPerformance-{{ uid }} .albora-itp__content {
      font-size: {{ s.content_font_size_mobile }}px;
    }
  }
</style>

{%- if entry != blank or request.design_mode -%}
  <section id="Albora-ImageTextPerformance-{{ uid }}" class="albora-itp">
    <div class="albora-itp__inner albora-itp__inner--{{ s.image_position }}">
      <div class="albora-itp__media{% if image_mobile == blank %} albora-itp__media--single{% endif %}">
        {%- if image_desktop != blank -%}
          {{
            image_desktop
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'albora-itp__img albora-itp__img--desktop',
              sizes: '(max-width: 749px) 100vw, 500px',
              widths: '400, 600, 800, 1000, 1200'
          }}
          {%- if image_mobile != blank -%}
            {{
              image_mobile
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                class: 'albora-itp__img albora-itp__img--mobile',
                sizes: '100vw',
                widths: '400, 600, 800, 1000'
            }}
          {%- endif -%}
        {%- else -%}
          <div class="albora-itp__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <div class="albora-itp__text">
        {%- if has_title != blank -%}
          <div class="albora-itp__title">{{ title }}</div>
        {%- endif -%}
        {%- if has_content != blank -%}
          <div class="albora-itp__content">{{ content }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Albora Imagem+Texto 1",
  "tag": "section",
  "class": "albora-image-text-performance-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posição da imagem (desktop)",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "max_width", "min": 1000, "max": 2000, "step": 20, "unit": "px", "label": "Largura máxima", "default": 1920 },

    { "type": "header", "content": "Layout — desktop" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Padding superior", "default": 60 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Padding inferior", "default": 60 },
    { "type": "range", "id": "padding_side_desktop", "min": 0, "max": 400, "step": 5, "unit": "px", "label": "Padding lateral", "default": 275 },
    { "type": "range", "id": "gap_desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Espaço entre imagem e texto", "default": 64 },
    { "type": "range", "id": "image_size_desktop", "min": 240, "max": 800, "step": 10, "unit": "px", "label": "Tamanho da imagem", "default": 500 },
    { "type": "range", "id": "text_gap_desktop", "min": 0, "max": 64, "step": 2, "unit": "px", "label": "Espaço entre título e texto", "default": 10 },

    { "type": "header", "content": "Layout — mobile" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding superior", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding inferior", "default": 40 },
    { "type": "range", "id": "padding_side_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Padding lateral", "default": 16 },
    { "type": "range", "id": "gap_mobile", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Espaço entre imagem e texto", "default": 32 },
    { "type": "range", "id": "image_height_mobile", "min": 200, "max": 600, "step": 4, "unit": "px", "label": "Altura da imagem", "default": 380 },
    { "type": "range", "id": "text_gap_mobile", "min": 0, "max": 48, "step": 2, "unit": "px", "label": "Espaço entre título e texto", "default": 10 },

    { "type": "header", "content": "Imagem" },
    { "type": "range", "id": "image_radius", "min": 0, "max": 48, "step": 2, "unit": "px", "label": "Raio da borda", "default": 24 },

    { "type": "header", "content": "Título — tipografia" },
    { "type": "range", "id": "title_font_size_desktop", "min": 20, "max": 96, "step": 1, "unit": "px", "label": "Tamanho (desktop)", "default": 42 },
    { "type": "range", "id": "title_font_size_mobile", "min": 16, "max": 72, "step": 1, "unit": "px", "label": "Tamanho (mobile)", "default": 24 },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Peso da fonte",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extrabold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "700"
    },
    { "type": "text", "id": "title_line_height", "label": "Altura da linha", "default": "0.92" },
    { "type": "color", "id": "title_color", "label": "Cor", "default": "#E74F3D" },
    { "type": "checkbox", "id": "title_uppercase", "label": "Título em maiúsculas", "default": true },

    { "type": "header", "content": "Conteúdo — tipografia" },
    { "type": "range", "id": "content_font_size_desktop", "min": 10, "max": 40, "step": 1, "unit": "px", "label": "Tamanho (desktop)", "default": 18 },
    { "type": "range", "id": "content_font_size_mobile", "min": 10, "max": 32, "step": 1, "unit": "px", "label": "Tamanho (mobile)", "default": 16 },
    {
      "type": "select",
      "id": "content_font_weight",
      "label": "Peso da fonte",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    { "type": "text", "id": "content_line_height", "label": "Altura da linha", "default": "1.35" },
    { "type": "color", "id": "content_color", "label": "Cor", "default": "#06262D" },
    { "type": "color", "id": "content_accent_color", "label": "Cor do destaque (negrito)", "default": "#06262D", "info": "Aplicada ao texto em negrito (<strong>) dentro do conteúdo." },

    { "type": "header", "content": "Geral" },
    { "type": "color", "id": "background_color", "label": "Cor de fundo da seção", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Albora Imagem+Texto 1" }]
}
{% endschema %}
