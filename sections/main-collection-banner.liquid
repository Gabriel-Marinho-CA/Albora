{%- comment -%}
  Albora — Banner principal da coleção + breadcrumb.
  Banner: imagem de fundo com altura fixa (desktop 156px / mobile 112px), título em position absolute por cima.
  Breadcrumb: Home > Todos os produtos > {{ collection.title }}, exibido logo abaixo do banner.
  Ver CLAUDE.md → "Regra de personalização de textos e botões".
{%- endcomment -%}

{{ 'albora-collection-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<style>
  #Albora-CollectionBanner-{{ uid }} .albora-collection-banner__media {
    height: 156px;
    {%- if s.image_desktop == blank %}
    background-color: {{ s.background_color }};
    {%- endif %}
  }
  #Albora-CollectionBanner-{{ uid }} .albora-collection-banner__title {
    font-size: {{ s.title_font_size_desktop }}px;
    font-weight: {{ s.title_font_weight }};
    color: {{ s.title_color }};
  }
  #Albora-CollectionBreadcrumb-{{ uid }} .albora-collection-breadcrumb__list {
    color: {{ s.breadcrumb_color }};
  }
  @media screen and (max-width: 749px) {
    #Albora-CollectionBanner-{{ uid }} .albora-collection-banner__media {
      height: 112px;
    }
    #Albora-CollectionBanner-{{ uid }} .albora-collection-banner__title {
      font-size: {{ s.title_font_size_mobile }}px;
    }
  }
</style>

<div id="Albora-CollectionBanner-{{ uid }}" class="albora-collection-banner">
  <div
    class="albora-collection-banner__media"
    {% if s.image_desktop != blank %}
      style="background-image: url({{ s.image_desktop | image_url: width: 2000 }});"
    {% endif %}
  >
    {%- if s.image_mobile != blank -%}
      <style>
        @media screen and (max-width: 749px) {
          #Albora-CollectionBanner-{{ uid }} .albora-collection-banner__media {
            background-image: url({{ s.image_mobile | image_url: width: 1200 }});
          }
        }
      </style>
    {%- endif -%}
    <div class="albora-collection-banner__content">
      <div class="page-width">
        <h1 class="albora-collection-banner__title">
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {{- collection.title | escape -}}
        </h1>
      </div>
    </div>
  </div>
</div>

{%- if s.show_breadcrumb -%}
  <div id="Albora-CollectionBreadcrumb-{{ uid }}" class="albora-collection-breadcrumb">
    <div class="page-width">
      <ul class="albora-collection-breadcrumb__list">
        <li class="albora-collection-breadcrumb__item">
          <a href="{{ routes.root_url }}" class="albora-collection-breadcrumb__link">
            {{- s.breadcrumb_home_label -}}
          </a>
          <span class="albora-collection-breadcrumb__separator">{{ 'icon-caret.svg' | inline_asset_content }}</span>
        </li>
        <li class="albora-collection-breadcrumb__item">
          <a href="{{ routes.all_products_collection_url }}" class="albora-collection-breadcrumb__link">
            {{- s.breadcrumb_all_products_label -}}
          </a>
          <span class="albora-collection-breadcrumb__separator">{{ 'icon-caret.svg' | inline_asset_content }}</span>
        </li>
        <li class="albora-collection-breadcrumb__item">
          <span class="albora-collection-breadcrumb__current">{{ collection.title | escape }}</span>
        </li>
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Imagem de fundo"
    },
    { "type": "image_picker", "id": "image_desktop", "label": "Imagem desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile" },
    { "type": "color", "id": "background_color", "label": "Cor de fundo (sem imagem)", "default": "#F2F0F0" },

    { "type": "header", "content": "Título" },
    { "type": "range", "id": "title_font_size_desktop", "min": 20, "max": 60, "step": 1, "unit": "px", "label": "Tamanho (desktop)", "default": 36 },
    { "type": "range", "id": "title_font_size_mobile", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Tamanho (mobile)", "default": 24 },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Peso da fonte",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    { "type": "color", "id": "title_color", "label": "Cor", "default": "#06262D" },

    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Mostrar breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_home_label", "label": "Texto do primeiro link", "default": "Home" },
    { "type": "text", "id": "breadcrumb_all_products_label", "label": "Texto do link intermediário", "default": "Todos os produtos" },
    { "type": "color", "id": "breadcrumb_color", "label": "Cor do texto", "default": "#06262D" }
  ]
}
{% endschema %}
