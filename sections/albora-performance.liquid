{%- comment -%}
  Albora — Performance.

  Conteúdo vem do metafield product.metafields.custom.secao_com_icones_e_imagens
  (referência a metaobjeto).

  Campos esperados no metaobjeto:
    titulo                   → single_line_text_field   (renderizado como <h2>)
    icones                   → list.file_reference      (ícones dos cards)
    texto                    → list.single_line_text_field (rótulo abaixo do ícone)
    imagem_fundo_desktop     → file_reference
    imagem_fundo_mobile      → file_reference
    imagem_produto_desktop   → file_reference
    imagem_produto_mobile    → file_reference

  Cada card = um ícone, pareado com o `texto` de mesmo índice.
  Os valores tipo "24,6g" também entram como imagem na lista `icones`.

  BUG DO SHOPIFY: listas de `file_reference` não podem ser acessadas por índice
  (`icones[2]` volta vazio). Por isso o loop principal é sobre `icones` — a lista de
  imagens só é percorrida com `{% for %}` — e é o `texto` (lista de string, que indexa
  normalmente) que é buscado por índice.

  Ver CLAUDE.md → "Regra de personalização de textos e botões".
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'albora-performance.css' | asset_url }}" media="all">

{%- liquid
  assign s = section.settings
  assign uid = section.id

  assign mo = product.metafields.custom.secao_com_icones_e_imagens.value

  assign title = mo.titulo.value | default: s.title_fallback
  assign icones = mo.icones.value
  assign textos = mo.texto.value

  assign bg_desktop = mo.imagem_fundo_desktop.value | default: s.image_bg_desktop
  assign bg_mobile = mo.imagem_fundo_mobile.value | default: s.image_bg_mobile
  assign product_desktop = mo.imagem_produto_desktop.value | default: s.image_product_desktop
  assign product_mobile = mo.imagem_produto_mobile.value | default: s.image_product_mobile
-%}

<style>
  #Albora-Performance-{{ uid }} .albora-performance__title {
    font-size: {{ s.title_font_size_desktop }}px;
    font-weight: {{ s.title_font_weight }};
    color: {{ s.title_color }};
  }
  #Albora-Performance-{{ uid }} .albora-performance__label {
    font-size: {{ s.label_font_size_desktop }}px;
    font-weight: {{ s.label_font_weight }};
    color: {{ s.label_color }};
    background: {{ s.label_background }};
  }
  @media screen and (max-width: 749px) {
    #Albora-Performance-{{ uid }} .albora-performance__title { font-size: {{ s.title_font_size_mobile }}px; }
    #Albora-Performance-{{ uid }} .albora-performance__label { font-size: {{ s.label_font_size_mobile }}px; }
  }
</style>

{%  if  mo != blank %}
<section id="Albora-Performance-{{ uid }}" class="albora-performance">
  {%- if bg_desktop != blank or bg_mobile != blank -%}
    <div class="albora-performance__bg">
      {%- if bg_desktop != blank -%}
        {%- if bg_desktop.url -%}
          <img src="{{ bg_desktop.url }}" alt="" loading="lazy" class="albora-performance__img--desktop">
        {%- else -%}
          {{
            bg_desktop
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              alt: '',
              class: 'albora-performance__img--desktop',
              sizes: '100vw',
              widths: '750, 1100, 1500, 2000'
          }}
        {%- endif -%}
      {%- endif -%}

      {%- if bg_mobile != blank -%}
        {%- if bg_mobile.url -%}
          <img src="{{ bg_mobile.url }}" alt="" loading="lazy" class="albora-performance__img--mobile">
        {%- else -%}
          {{
            bg_mobile
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              alt: '',
              class: 'albora-performance__img--mobile',
              sizes: '100vw',
              widths: '400, 600, 800, 1200'
          }}
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="albora-performance__inner">
    {%- if title != blank -%}
      <h2 class="albora-performance__title">{{ title }}</h2>
    {%- endif -%}

    {%- if icones.size > 0 -%}
      <ul class="albora-performance__list">
        {%- for icone in icones -%}
          {%- assign texto = textos[forloop.index0] -%}
          <li class="albora-performance__card">
            <div class="albora-performance__card-top">
              {{
                icone
                | image_url: width: 300
                | image_tag:
                  loading: 'lazy',
                  alt: texto,
                  class: 'albora-performance__icon',
                  sizes: '76px',
                  widths: '76, 152, 228, 300'
              }}
            </div>
            {%- if texto != blank -%}
              <span class="albora-performance__label">{{ texto }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if product_desktop != blank or product_mobile != blank -%}
    <div class="albora-performance__product">
      {%- if product_desktop != blank -%}
        {%- if product_desktop.url -%}
          <img src="{{ product_desktop.url }}" alt="" loading="lazy" class="albora-performance__img--desktop">
        {%- else -%}
          {{
            product_desktop
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              alt: '',
              class: 'albora-performance__img--desktop',
              sizes: '(min-width: 750px) 976px, 100vw',
              widths: '600, 900, 1200, 1400'
          }}
        {%- endif -%}
      {%- endif -%}

      {%- if product_mobile != blank -%}
        {%- if product_mobile.url -%}
          <img src="{{ product_mobile.url }}" alt="" loading="lazy" class="albora-performance__img--mobile">
        {%- else -%}
          {{
            product_mobile
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              alt: '',
              class: 'albora-performance__img--mobile',
              sizes: '100vw',
              widths: '400, 600, 800, 1000'
          }}
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
{%  endif %}



{% schema %}
{
  "name": "Albora Performance",
  "tag": "section",
  "class": "albora-performance-section",
  "settings": [
    { "type": "header", "content": "Origem do conteúdo" },
    {
      "type": "paragraph",
      "content": "O conteúdo vem do metafield product.metafields.custom.secao_com_icones_e_imagens (referência a metaobjeto). Campos: titulo, icones (lista), texto (lista), imagem_fundo_desktop, imagem_fundo_mobile, imagem_produto_desktop, imagem_produto_mobile. Cada ícone é pareado com o texto de mesma posição."
    },

    { "type": "header", "content": "Fallback " },
    { "type": "text", "id": "title_fallback", "label": "Título", "default": "Máxima performance para o seu corpo" },
    { "type": "image_picker", "id": "image_bg_desktop", "label": "Imagem de fundo (desktop)" },
    { "type": "image_picker", "id": "image_bg_mobile", "label": "Imagem de fundo (mobile)" },
    { "type": "image_picker", "id": "image_product_desktop", "label": "Imagem do produto (desktop)" },
    { "type": "image_picker", "id": "image_product_mobile", "label": "Imagem do produto (mobile)" },

    { "type": "header", "content": "Título — tipografia" },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "min": 20,
      "max": 96,
      "step": 1,
      "unit": "px",
      "label": "Tamanho (desktop)",
      "default": 55
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Tamanho (mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Peso da fonte",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "900"
    },
    { "type": "color", "id": "title_color", "label": "Cor", "default": "#FFFFFF" },

    { "type": "header", "content": "Texto do ícone — tipografia" },
    {
      "type": "range",
      "id": "label_font_size_desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Tamanho (desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "label_font_size_mobile",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamanho (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "label_font_weight",
      "label": "Peso da fonte",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    { "type": "color", "id": "label_color", "label": "Cor", "default": "#FFFFFF" },
    { "type": "color", "id": "label_background", "label": "Cor de fundo", "default": "#E74F3D" }
  ],
  "presets": [{ "name": "Albora Performance" }]
}
{% endschema %}
