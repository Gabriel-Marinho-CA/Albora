      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Linhas — tamanho (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "body_font_size_mobile",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Linhas — tamanho (mobile)",
      "default": 12
    },
    {
      "type": "select",
      "id": "body_font_weight",
      "label": "Linhas — peso",
