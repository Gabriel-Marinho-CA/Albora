    {
      "type": "range",
      "id": "card_title_font_size_mobile",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Título do card — tamanho (mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "card_title_font_weight",
