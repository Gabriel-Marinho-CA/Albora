      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Cabeçalho — tamanho (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "head_font_size_mobile",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Cabeçalho — tamanho (mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "head_font_weight",
      "label": "Cabeçalho — peso",
